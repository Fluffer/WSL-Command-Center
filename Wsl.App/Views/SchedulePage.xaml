<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wsl.App.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="4" MaxWidth="1064" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Scheduled backups" Style="{StaticResource TitleTextBlockStyle}" />
                <muxc:ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Width="20" Height="20"
                                   VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="0,4,0,16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Run an automatic `wsl --export` on a schedule via Windows Task Scheduler. Each run writes a timestamped archive and keeps only the newest N. Export needs no admin rights, so no UAC prompt." />

            <muxc:InfoBar IsOpen="{x:Bind Vm.ErrorMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Error" Message="{x:Bind Vm.ErrorMessage, Mode=OneWay}" Margin="0,0,0,4" />
            <muxc:InfoBar IsOpen="{x:Bind Vm.StatusMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Success" Message="{x:Bind Vm.StatusMessage, Mode=OneWay}" Margin="0,0,0,4" />

            <!-- ===== New schedule ===== -->
            <controls:SettingsExpander
                Header="New schedule"
                Description="Create a recurring backup task for one distro."
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE823;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="Distro"
                        Description="Which installed distribution to back up.">
                        <ComboBox MinWidth="220"
                                  ItemsSource="{x:Bind Vm.Distros, Mode=OneWay}"
                                  SelectedItem="{x:Bind Vm.Distro, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Destination folder"
                        Description="Folder where timestamped archives are written.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{x:Bind Vm.Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="240" />
                            <Button Content="Browse…" Click="BrowseFolder_Click" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Format"
                        Description="tar = portable filesystem. tar.gz = compressed. vhd = WSL2 virtual disk.">
                        <ComboBox MinWidth="140"
                                  ItemsSource="{x:Bind Vm.Formats}" SelectedItem="{x:Bind Vm.Format, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="When and how many"
                        Description="How often the task runs, at what time, and how many newest archives to keep.">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox Header="Frequency" MinWidth="130"
                                      ItemsSource="{x:Bind Vm.Frequencies}" SelectedItem="{x:Bind Vm.Frequency, Mode=TwoWay}" />
                            <TextBox Header="Time (HH:mm)" MinWidth="110"
                                     Text="{x:Bind Vm.Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <muxc:NumberBox Header="Keep newest" Value="{x:Bind Vm.KeepCount, Mode=TwoWay}"
                                            Minimum="1" Maximum="365" SpinButtonPlacementMode="Compact" MinWidth="130" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Create"
                        Description="Register the task, or copy the backup script it runs.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Create schedule" Command="{x:Bind Vm.CreateCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="CopyPs_Click"
                                    ToolTipService.ToolTip="Copy the backup script this schedule runs to the clipboard">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE756;" FontSize="14" />
                                    <TextBlock Text="Copy PowerShell" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- ===== Existing schedules ===== -->
            <controls:SettingsExpander
                Header="Existing schedules"
                Description="Backup tasks created by this app (Task Scheduler names beginning WslCmdCenter_Backup_)."
                IsExpanded="True"
                ItemsSource="{x:Bind Vm.Schedules, Mode=OneWay}">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7C4;" />
                </controls:SettingsExpander.HeaderIcon>
                <Button Command="{x:Bind Vm.LoadCommand}" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <controls:SettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <controls:SettingsCard Header="{x:Bind}">
                            <Button Click="Delete_Click" Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Delete this scheduled task">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </controls:SettingsCard>
                    </DataTemplate>
                </controls:SettingsExpander.ItemTemplate>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
