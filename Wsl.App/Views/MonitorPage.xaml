<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wsl.App.Views.MonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:monitoring="using:Wsl.Core.Monitoring">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- Header row -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Monitor" Style="{StaticResource TitleTextBlockStyle}" />
                <Button Command="{x:Bind Vm.RefreshCommand}"
                        ToolTipService.ToolTip="Refresh metrics now"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="MonitorRefreshButton">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <muxc:ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}"
                                   Width="20" Height="20" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Live resource snapshot — refreshes every 5 seconds while this page is open. CPU values for individual distributions are approximate (sampled between two 5-second intervals)." />

            <!-- Error bar -->
            <muxc:InfoBar IsOpen="{x:Bind Vm.ErrorMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Error"
                          Message="{x:Bind Vm.ErrorMessage, Mode=OneWay}" />

            <!-- WSL2 VM summary card -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="WSL2 Virtual Machine" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="32">
                        <StackPanel Spacing="2">
                            <TextBlock Text="CPU" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="1">
                                <TextBlock Text="{x:Bind Vm.Vm.CpuPercent, Mode=OneWay}" />
                                <TextBlock Text=" %" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Working Set" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Vm.Vm.WorkingSetBytes, Mode=OneWay, Converter={StaticResource BytesToGb}}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="VHDX Total" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Vm.Vm.DiskBytes, Mode=OneWay, Converter={StaticResource BytesToGb}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Running distributions list -->
            <TextBlock Text="Running distributions" Style="{StaticResource SubtitleTextBlockStyle}" />

            <ListView ItemsSource="{x:Bind Vm.Rows, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="monitoring:DistroMetrics">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Distro name -->
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Name}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <!-- Metrics -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="28"
                                            VerticalAlignment="Center">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="CPU (approx)"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="1">
                                            <TextBlock Text="{x:Bind CpuPercent}" />
                                            <TextBlock Text=" %" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Mem used / total"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind MemUsedBytes, Converter={StaticResource BytesToGb}}" />
                                            <TextBlock Text="/"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind MemTotalBytes, Converter={StaticResource BytesToGb}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Disk used / total"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{x:Bind DiskUsedBytes, Converter={StaticResource BytesToGb}}" />
                                            <TextBlock Text="/"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind DiskTotalBytes, Converter={StaticResource BytesToGb}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Per-row Terminate -->
                                <Button Grid.Column="2"
                                        Content="Terminate"
                                        Tag="{x:Bind Name}"
                                        Click="Terminate_Click"
                                        AutomationProperties.AutomationId="TerminateDistroButton"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Restart VM -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Restart VM"
                        Click="RestartVm_Click"
                        AutomationProperties.AutomationId="RestartVmButton" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
