<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wsl.App.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Scheduled backups" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Run an automatic `wsl --export` on a schedule via Windows Task Scheduler. Each run writes a timestamped archive and keeps only the newest N. Export needs no admin rights, so no UAC prompt." />

            <muxc:InfoBar IsOpen="{x:Bind Vm.ErrorMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Error" Message="{x:Bind Vm.ErrorMessage, Mode=OneWay}" />
            <muxc:InfoBar IsOpen="{x:Bind Vm.StatusMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Success" Message="{x:Bind Vm.StatusMessage, Mode=OneWay}" />

            <!-- New schedule -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="New schedule" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox Header="Distro" Width="240" HorizontalAlignment="Left"
                              ItemsSource="{x:Bind Vm.Distros, Mode=OneWay}"
                              SelectedItem="{x:Bind Vm.Distro, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Header="Destination folder" Text="{x:Bind Vm.Folder, Mode=TwoWay}" Width="320" />
                        <Button Content="Browse…" Click="BrowseFolder_Click" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <ComboBox Header="Format" Width="160" HorizontalAlignment="Left"
                              ItemsSource="{x:Bind Vm.Formats}" SelectedItem="{x:Bind Vm.Format, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox Header="Frequency" Width="140"
                                  ItemsSource="{x:Bind Vm.Frequencies}" SelectedItem="{x:Bind Vm.Frequency, Mode=TwoWay}" />
                        <TextBox Header="Time (HH:mm)" Text="{x:Bind Vm.Time, Mode=TwoWay}" Width="120" />
                        <muxc:NumberBox Header="Keep newest" Value="{x:Bind Vm.KeepCount, Mode=TwoWay}"
                                        Minimum="1" Maximum="365" SpinButtonPlacementMode="Compact" Width="140" />
                    </StackPanel>
                    <Button Content="Create schedule" Command="{x:Bind Vm.CreateCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Border>

            <!-- Existing schedules -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Existing schedules" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button Command="{x:Bind Vm.LoadCommand}" ToolTipService.ToolTip="Refresh">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                        <muxc:ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Width="18" Height="18" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Backup tasks created by this app (Task Scheduler names beginning WslCmdCenter_Backup_)." />
                    <ListView ItemsSource="{x:Bind Vm.Schedules, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnSpacing="12" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Click="Delete_Click" Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Delete this scheduled task">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
