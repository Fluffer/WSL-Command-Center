<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wsl.App.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Wsl.App.Logic.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Diagnostics" Style="{StaticResource TitleTextBlockStyle}" />
                <Button Command="{x:Bind Vm.RunCommand}"
                        ToolTipService.ToolTip="Re-run all health checks"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="RunDiagnosticsButton">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9F3;" FontSize="14" />
                        <TextBlock Text="Run checks" />
                    </StackPanel>
                </Button>
                <muxc:ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}"
                                   Width="20" Height="20" VerticalAlignment="Center" />
            </StackPanel>

            <muxc:InfoBar IsOpen="{x:Bind Vm.ErrorMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Error" Message="{x:Bind Vm.ErrorMessage, Mode=OneWay}" />
            <muxc:InfoBar IsOpen="{x:Bind Vm.StatusMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Success" Message="{x:Bind Vm.StatusMessage, Mode=OneWay}" />

            <!-- Results -->
            <ListView ItemsSource="{x:Bind Vm.Rows}" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DiagnosticRow">
                        <Border Style="{StaticResource CardBorderStyle}"
                                AutomationProperties.Name="{x:Bind Converter={StaticResource ListItemAccessibleName}}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons"
                                          Glyph="{x:Bind Glyph}" FontSize="18"
                                          VerticalAlignment="Top" Margin="0,2,0,0" />

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Title}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind SeverityLabel}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Button Grid.Column="2" Content="{x:Bind FixLabel}"
                                        Visibility="{x:Bind HasFix, Converter={StaticResource BoolToVis}}"
                                        Click="ApplyFix_Click"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="ApplyFixButton" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>
</Page>
