<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wsl.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="4" MaxWidth="1064" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

            <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,6" />

            <controls:SettingsCard
                Header="App theme"
                Description="'Use system setting' follows your Windows light/dark mode. Below the line: popular developer palettes (Dracula, Nord, Catppuccin…) that recolor the whole app.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeCombo" MinWidth="200" SelectionChanged="Setting_Changed" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Header="Accent color"
                Description="Highlight color for buttons and selections. 'Default' follows your Windows accent.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE771;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="AccentCombo" MinWidth="200" SelectionChanged="Setting_Changed" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Header="Font"
                Description="Font used across the app. Monospace options (Cascadia, Consolas) give a console feel.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8D2;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="FontCombo" MinWidth="200" SelectionChanged="Setting_Changed" />
            </controls:SettingsCard>

            <TextBlock Text="Developer" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,16,0,6" />

            <controls:SettingsCard
                Header="Developer mode"
                Description="Reveals advanced diagnostics tools. Leave off unless you are troubleshooting WSL itself.">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEC7A;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="DeveloperToggle" Toggled="DeveloperToggle_Toggled" />
            </controls:SettingsCard>

            <controls:SettingsCard
                x:Name="DiagnosticsCard"
                Visibility="Collapsed"
                Header="Diagnostics"
                Description="Open the WSL2 debug shell — an advanced diagnostics console attached to the WSL2 virtual machine. For troubleshooting only. Requires administrator rights (expect an elevation prompt).">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE756;" />
                </controls:SettingsCard.HeaderIcon>
                <Button x:Name="DebugShellButton" Content="Open WSL2 debug shell" Click="DebugShell_Click" />
            </controls:SettingsCard>

            <InfoBar x:Name="DiagnosticsErrorBar" Severity="Error" IsOpen="False" Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
