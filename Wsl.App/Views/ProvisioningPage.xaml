<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wsl.App.Views.ProvisioningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:core="using:Wsl.Core">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- Header row -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Provisioning" Style="{StaticResource TitleTextBlockStyle}" />
                <Button Command="{x:Bind Vm.LoadDistrosCommand}"
                        ToolTipService.ToolTip="Refresh distro list"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ProvisioningRefreshButton">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <muxc:ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}"
                                   Width="20" Height="20" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Error / status bars -->
            <muxc:InfoBar IsOpen="{x:Bind Vm.ErrorMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Error"
                          Message="{x:Bind Vm.ErrorMessage, Mode=OneWay}" />
            <muxc:InfoBar IsOpen="{x:Bind Vm.StatusMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Success"
                          Message="{x:Bind Vm.StatusMessage, Mode=OneWay}" />

            <!-- Apply template card -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Apply a template" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Runs setup commands inside the selected distro as root. Re-applying re-runs every step; built-in templates are safe to run twice. Debian/Ubuntu only."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
                        <ComboBox MinWidth="220" Header="Distribution"
                                  ItemsSource="{x:Bind Vm.Distros}"
                                  SelectedItem="{x:Bind Vm.SelectedDistro, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  PlaceholderText="No distros loaded"
                                  AutomationProperties.AutomationId="ProvisionDistroComboBox" />
                        <ComboBox MinWidth="240" Header="Template"
                                  ItemsSource="{x:Bind Vm.Templates}"
                                  SelectedItem="{x:Bind Vm.SelectedTemplate, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  AutomationProperties.AutomationId="ProvisionTemplateComboBox" />
                        <Button Content="Apply" VerticalAlignment="Bottom"
                                Click="ApplyTemplate_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="ApplyTemplateButton" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind Vm.SelectedTemplate.Description, Mode=OneWay, FallbackValue=''}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Per-step results -->
                    <ListView ItemsSource="{x:Bind Vm.StepResults}" SelectionMode="None"
                              AutomationProperties.AutomationId="StepResultsList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="core:StepResult">
                                <Grid ColumnSpacing="10"
                                      AutomationProperties.Name="{x:Bind Converter={StaticResource ListItemAccessibleName}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons"
                                              Glyph="{x:Bind Success, Converter={StaticResource BoolToStatusGlyph}}"
                                              VerticalAlignment="Top" FontSize="14" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Description}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Output}"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Clone card -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Clone a distro" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Exports the source distro and re-imports it under a new name and directory. The source is unchanged."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ComboBox MinWidth="220" Header="Source distribution"
                              ItemsSource="{x:Bind Vm.Distros}"
                              SelectedItem="{x:Bind Vm.CloneSource, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              PlaceholderText="No distros loaded"
                              AutomationProperties.AutomationId="CloneSourceComboBox" />

                    <TextBox Header="New name"
                             Text="{x:Bind Vm.CloneNewName, Mode=TwoWay}"
                             MinWidth="220"
                             AutomationProperties.AutomationId="CloneNewNameTextBox" />

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <TextBox Header="Install directory"
                                 Text="{x:Bind Vm.CloneInstallDir, Mode=TwoWay}"
                                 MinWidth="360"
                                 AutomationProperties.AutomationId="CloneInstallDirTextBox" />
                        <Button Content="Browse…" VerticalAlignment="Bottom"
                                Click="BrowseCloneDir_Click"
                                AutomationProperties.AutomationId="BrowseCloneDirButton" />
                    </StackPanel>

                    <Button Content="Clone" HorizontalAlignment="Left"
                            Click="Clone_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="CloneButton" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
