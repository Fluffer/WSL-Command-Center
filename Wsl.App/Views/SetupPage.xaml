<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wsl.App.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="4" MaxWidth="1064" HorizontalAlignment="Stretch">
            <TextBlock Text="Set up / repair WSL" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Enables the required Windows features, installs the WSL kernel, and sets the default version to 2. Requires administrator approval (UAC)." />

            <muxc:InfoBar IsOpen="{x:Bind Vm.ErrorMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Error" Message="{x:Bind Vm.ErrorMessage, Mode=OneWay}" Margin="0,0,0,4" />
            <muxc:InfoBar IsOpen="{x:Bind Vm.StatusMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Informational" Message="{x:Bind Vm.StatusMessage, Mode=OneWay}" Margin="0,0,0,4" />
            <muxc:InfoBar IsOpen="{x:Bind Vm.RebootRequired, Mode=OneWay}" Severity="Warning"
                          Title="Restart required" Margin="0,0,0,4"
                          Message="Restart Windows to finish, then reopen this app to continue automatically.">
                <muxc:InfoBar.ActionButton>
                    <Button Content="Restart now" Click="Restart_Click" />
                </muxc:InfoBar.ActionButton>
            </muxc:InfoBar>

            <controls:SettingsExpander
                Header="Enable WSL features"
                Description="Turns on Virtual Machine Platform + WSL, installs the kernel, and sets WSL 2 as default."
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE90F;" />
                </controls:SettingsExpander.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <muxc:ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                    <Button Content="Enable WSL features" Command="{x:Bind Vm.EnableFeaturesCommand}"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button Click="CopyFeaturesPs_Click"
                            ToolTipService.ToolTip="Copy the equivalent elevated commands to the clipboard">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE756;" FontSize="14" />
                            <TextBlock Text="Copy PowerShell" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard ContentAlignment="Left">
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="Steps: 1) enable the Virtual Machine Platform + WSL Windows features, 2) restart if required, 3) install/update the WSL kernel, 4) set WSL 2 as the default. Each privileged step runs through an elevated helper, so you'll see a Windows UAC prompt. Progress is saved, so setup resumes automatically after the restart." />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
