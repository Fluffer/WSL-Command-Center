<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wsl.App.Views.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="Configuration" Style="{StaticResource TitleTextBlockStyle}" />

            <muxc:InfoBar IsOpen="{x:Bind Vm.ErrorMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                         Severity="Error" Message="{x:Bind Vm.ErrorMessage, Mode=OneWay}" />
            <muxc:InfoBar IsOpen="{x:Bind Vm.StatusMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                         Severity="Informational" Message="{x:Bind Vm.StatusMessage, Mode=OneWay}" />

            <muxc:Pivot>
                <muxc:PivotItem Header="Global (.wslconfig)">
                    <StackPanel Spacing="12" Margin="0,12,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Settings in ~/.wslconfig apply to all WSL2 distros. After saving, run `wsl --shutdown` (button below) for changes to take effect." />
                        <Button Content="Load" Command="{x:Bind Vm.LoadGlobalCommand}" />
                        <TextBox Header="Memory (e.g. 8GB)" Text="{x:Bind Vm.Memory, Mode=TwoWay}" Width="240" />
                        <TextBlock Text="{x:Bind Vm.MemoryDefaultHint}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" />
                        <TextBox Header="Processors" Text="{x:Bind Vm.Processors, Mode=TwoWay}" Width="240" />
                        <TextBlock Text="{x:Bind Vm.ProcessorsDefaultHint}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" />
                        <ComboBox Header="Networking mode" Width="240" IsEditable="True"
                                  ItemsSource="{x:Bind Vm.NetworkingModes}"
                                  Text="{x:Bind Vm.Networking, Mode=TwoWay}" />
                        <TextBlock Text="Empty = NAT (the WSL2 default). 'mirrored' shares the Windows network stack." Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" />
                        <ToggleSwitch Header="Localhost forwarding" IsOn="{x:Bind Vm.LocalhostForwarding, Mode=TwoWay}" />
                        <Button Content="Save" Command="{x:Bind Vm.SaveGlobalCommand}" />
                    </StackPanel>
                </muxc:PivotItem>
                <muxc:PivotItem Header="Per-distro (wsl.conf)">
                    <StackPanel Spacing="12" Margin="0,12,0,0">
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Edits /etc/wsl.conf inside the selected distro (written as root). Run `wsl --shutdown` after saving to apply." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Header="Distro" Width="200"
                                      ItemsSource="{x:Bind Vm.Distros, Mode=OneWay}"
                                      SelectedItem="{x:Bind Vm.SelectedDistro, Mode=TwoWay}"
                                      SelectionChanged="Distro_SelectionChanged" />
                            <Button Content="Refresh" Command="{x:Bind Vm.LoadDistrosCommand}" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <Button Content="Load" Command="{x:Bind Vm.LoadDistroCommand}" />
                        <TextBox Header="Default user" Text="{x:Bind Vm.DefaultUser, Mode=TwoWay}" Width="240" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                   Text="The Linux user this distro logs in as by default." />
                        <ToggleSwitch Header="systemd" IsOn="{x:Bind Vm.Systemd, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                   Text="Enable the systemd init system (required by some software like snap or systemd services)." />
                        <TextBox Header="Hostname" Text="{x:Bind Vm.Hostname, Mode=TwoWay}" Width="240" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                   Text="Hostname shown inside the distro." />
                        <Button Content="Save" Command="{x:Bind Vm.SaveDistroCommand}" />
                    </StackPanel>
                </muxc:PivotItem>
            </muxc:Pivot>

            <Button Content="Shutdown WSL now" Click="Shutdown_Click" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                       Text="Immediately stops all running distros so configuration changes take effect." />
            <muxc:ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
