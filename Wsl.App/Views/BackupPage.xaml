<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wsl.App.Views.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="Backup &amp; restore" Style="{StaticResource TitleTextBlockStyle}" />

            <muxc:InfoBar IsOpen="{x:Bind Vm.ErrorMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                         Severity="Error" Message="{x:Bind Vm.ErrorMessage, Mode=OneWay}" />
            <muxc:InfoBar IsOpen="{x:Bind Vm.StatusMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                         Severity="Success" Message="{x:Bind Vm.StatusMessage, Mode=OneWay}" />

            <!-- ===== Export ===== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Export" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Save a distribution to a single archive file you can store or copy elsewhere. The distro keeps working normally during export." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox Header="Distro" Width="240"
                                  ItemsSource="{x:Bind Vm.Distros, Mode=OneWay}"
                                  SelectedItem="{x:Bind Vm.ExportDistro, Mode=TwoWay}" />
                        <Button Content="Refresh" Command="{x:Bind Vm.LoadDistrosCommand}" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <ComboBox Header="Format" ItemsSource="{x:Bind Vm.Formats}"
                              SelectedItem="{x:Bind Vm.ExportFormat, Mode=TwoWay}" Width="160" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                               Text="tar = portable Linux filesystem (most compatible). tar.gz = compressed tar (smaller file, slower). vhd = WSL2 virtual disk (fast to re-import, larger file)." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Header="Output path" Text="{x:Bind Vm.ExportPath, Mode=TwoWay}" Width="280" />
                        <Button Content="Browse…" Click="BrowseExport_Click" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                               Text="Where to write the archive file." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Export" Command="{x:Bind Vm.ExportCommand}" Style="{StaticResource AccentButtonStyle}" />
                        <Button Click="CopyExportPs_Click"
                                ToolTipService.ToolTip="Copy the equivalent wsl.exe command to the clipboard">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE756;" FontSize="14" />
                                <TextBlock Text="Copy PowerShell" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== Restore ===== -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Restore" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Recreate a distribution from an archive made here or on another machine." />
                    <TextBox Header="New name" Text="{x:Bind Vm.RestoreName, Mode=TwoWay}" Width="320" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                               Text="Name for the recreated distro. Must not match an existing distro." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Header="Install directory" Text="{x:Bind Vm.RestoreInstallDir, Mode=TwoWay}" Width="280" />
                        <Button Content="Browse…" Click="BrowseRestoreDir_Click" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                               Text="Folder on Windows where the restored distro's virtual disk will be stored. Pick an empty folder you own, e.g. C:\WSL\&lt;name&gt;." />
                    <ComboBox Header="Source format" ItemsSource="{x:Bind Vm.Formats}"
                              SelectedItem="{x:Bind Vm.RestoreFormat, Mode=TwoWay}" Width="160" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                               Text="Match the archive type. Pick vhd only for a .vhdx disk image; tar and tar.gz both restore as a filesystem." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Header="Archive" Text="{x:Bind Vm.RestoreArchivePath, Mode=TwoWay}" Width="280" />
                        <Button Content="Browse…" Click="BrowseRestore_Click" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                               Text="The backup file to restore (.tar, .tar.gz, or .vhdx)." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Restore" Command="{x:Bind Vm.RestoreCommand}" Style="{StaticResource AccentButtonStyle}" />
                        <Button Click="CopyRestorePs_Click"
                                ToolTipService.ToolTip="Copy the equivalent wsl.exe command to the clipboard">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE756;" FontSize="14" />
                                <TextBlock Text="Copy PowerShell" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <muxc:ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
