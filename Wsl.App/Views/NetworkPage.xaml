<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wsl.App.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:diag="using:Wsl.Core.Diagnostics">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- Header row -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Network" Style="{StaticResource TitleTextBlockStyle}" />
                <Button Command="{x:Bind Vm.RefreshCommand}"
                        ToolTipService.ToolTip="Refresh network diagnostics"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="NetworkRefreshButton">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <muxc:ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}"
                                   Width="20" Height="20" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Error bar -->
            <muxc:InfoBar IsOpen="{x:Bind Vm.ErrorMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Error"
                          Message="{x:Bind Vm.ErrorMessage, Mode=OneWay}" />

            <!-- Status bar (non-error, e.g. mode applied) -->
            <muxc:InfoBar IsOpen="{x:Bind Vm.StatusMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Success"
                          Message="{x:Bind Vm.StatusMessage, Mode=OneWay}" />

            <!-- Distro selector -->
            <StackPanel Spacing="6">
                <TextBlock Text="Distribution"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="DistroComboBox"
                          ItemsSource="{x:Bind Vm.Distros}"
                          SelectedItem="{x:Bind Vm.SelectedDistro, Mode=TwoWay}"
                          SelectionChanged="DistroComboBox_SelectionChanged"
                          PlaceholderText="No running distros"
                          MinWidth="220"
                          AutomationProperties.AutomationId="NetworkDistroComboBox" />
            </StackPanel>

            <!-- Network info card -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Network" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="32" FlowDirection="LeftToRight">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Distro IP"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Vm.Network.DistroIp, Mode=OneWay, FallbackValue='—'}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Host / Gateway IP"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Vm.Network.HostGatewayIp, Mode=OneWay, FallbackValue='—'}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="DNS Servers"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl ItemsSource="{x:Bind Vm.Network.DnsServers, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Networking mode switcher (global, affects all distros) -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Networking Mode" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Global .wslconfig setting — applies to all WSL 2 distros. Changing it shuts WSL down."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
                        <StackPanel Spacing="2" VerticalAlignment="Bottom">
                            <TextBlock Text="Current (.wslconfig)"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Vm.CurrentModeLabel, Mode=OneWay, FallbackValue='—'}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       AutomationProperties.AutomationId="CurrentNetworkModeText" />
                        </StackPanel>
                        <ComboBox x:Name="ModeComboBox" MinWidth="240"
                                  Header="Set mode"
                                  ItemsSource="{x:Bind Vm.NetworkModes}"
                                  SelectedItem="{x:Bind Vm.SelectedMode, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  AutomationProperties.AutomationId="NetworkModeComboBox" />
                        <Button Content="Apply" VerticalAlignment="Bottom"
                                Click="ApplyNetworkMode_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="ApplyNetworkModeButton" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Vm.SelectedMode.Description, Mode=OneWay, FallbackValue=''}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Port forwards -->
            <TextBlock Text="Port Forwards" Style="{StaticResource SubtitleTextBlockStyle}" />

            <ListView ItemsSource="{x:Bind Vm.PortForwards}"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="diag:PortForward">
                        <Border Style="{StaticResource CardBorderStyle}"
                                AutomationProperties.Name="{x:Bind Converter={StaticResource ListItemAccessibleName}}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal" Spacing="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ListenAddress}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text=":" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ListenPort}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="  →  "
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="4,0" />
                                    <TextBlock Text="{x:Bind ConnectAddress}" />
                                    <TextBlock Text=":" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ConnectPort}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Delete"
                                        Click="DeletePortForward_Click"
                                        AutomationProperties.AutomationId="DeletePortForwardButton"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- GPU card -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="GPU" Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Button Content="Re-detect"
                                Command="{x:Bind Vm.ProbeGpuCommand}"
                                AutomationProperties.AutomationId="RedetectGpuButton"
                                VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- DXG + NVIDIA present row (always visible) -->
                    <StackPanel Orientation="Horizontal" Spacing="32">
                        <StackPanel Spacing="2">
                            <TextBlock Text="/dev/dxg present"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind FormatBool(Vm.GpuInfo.DxgPresent), Mode=OneWay, FallbackValue='—'}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="NVIDIA detected"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind FormatBool(Vm.GpuInfo.NvidiaDetected), Mode=OneWay, FallbackValue='—'}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- No-NVIDIA note (shown when NvidiaDetected is false or GpuInfo is null) -->
                    <TextBlock Text="No NVIDIA GPU detected (or driver not installed in distro)"
                               Visibility="{x:Bind ShowNoNvidiaNote(Vm.GpuInfo), Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontStyle="Italic" />

                    <!-- NVIDIA details (shown only when NvidiaDetected is true) -->
                    <StackPanel Orientation="Horizontal" Spacing="32"
                                Visibility="{x:Bind ShowNvidiaDetails(Vm.GpuInfo), Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Name"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Vm.GpuInfo.Name, Mode=OneWay, FallbackValue='—'}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Driver Version"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Vm.GpuInfo.DriverVersion, Mode=OneWay, FallbackValue='—'}" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Memory (MB used / total)"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind Vm.GpuInfo.MemUsedMb, Mode=OneWay, FallbackValue='—'}" />
                                <TextBlock Text="/"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Vm.GpuInfo.MemTotalMb, Mode=OneWay, FallbackValue='—'}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Bottom command bar -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Restart networking"
                        Click="RestartNetworking_Click"
                        AutomationProperties.AutomationId="RestartNetworkingButton" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
