<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Wsl.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Run unpackaged with the WindowsAppRuntime bundled, so no machine-wide runtime
         install is required (avoids REGDB_E_CLASSNOTREG from DeploymentManager auto-init). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\WslLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.3.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Wsl.Core\Wsl.Core.csproj" />
    <ProjectReference Include="..\Wsl.Contracts\Wsl.Contracts.csproj" />
    <ProjectReference Include="..\Wsl.App.Logic\Wsl.App.Logic.csproj" />
  </ItemGroup>

  <!-- Copy broker exe next to the app so BrokerClient can find it via AppContext.BaseDirectory.
       Using a Target + MSBuild task instead of ProjectReference to avoid NETSDK1150 (self-contained
       app cannot ProjectReference a framework-dependent exe). -->
  <Target Name="BuildAndCopyBroker" BeforeTargets="Build">
    <!-- RemoveProperties strips the app's RID/platform globals: the broker is a plain
         framework-dependent net9.0 exe and is not restored for RID-specific targets.
         (Publish.ps1 separately publishes the broker self-contained for deployment zips.) -->
    <MSBuild Projects="..\Wsl.Broker\Wsl.Broker.csproj" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;Platform;PlatformTarget;SelfContained;WindowsAppSDKSelfContained;PublishReadyToRun;PublishTrimmed" Targets="Build" />
    <PropertyGroup>
      <_BrokerBinDir>..\Wsl.Broker\bin\$(Configuration)\net9.0\</_BrokerBinDir>
    </PropertyGroup>
    <ItemGroup>
      <_BrokerFiles Include="$(_BrokerBinDir)Wsl.Broker.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(_BrokerFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Trimming is OFF even for Release: a trimmed publish starts but never shows a window —
         XAML/WinRT resolve types reflectively (IL2026/IL2104 warnings) and the trimmer cuts them.
         Verified broken 2026-06-07; re-test with a real smoke run before ever re-enabling. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>
