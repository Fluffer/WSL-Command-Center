<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wsl.App.Views.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="4" MaxWidth="1064" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                <TextBlock Text="Backup &amp; restore" Style="{StaticResource TitleTextBlockStyle}" />
                <muxc:ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Width="20" Height="20"
                                   VerticalAlignment="Center" />
            </StackPanel>

            <muxc:InfoBar IsOpen="{x:Bind Vm.ErrorMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Error" Message="{x:Bind Vm.ErrorMessage, Mode=OneWay}" Margin="0,0,0,4" />
            <muxc:InfoBar IsOpen="{x:Bind Vm.StatusMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Success" Message="{x:Bind Vm.StatusMessage, Mode=OneWay}" Margin="0,0,0,4" />

            <!-- ===== Export ===== -->
            <controls:SettingsExpander
                Header="Export"
                Description="Save a distribution to a single archive file. The distro keeps working normally during export."
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE7B8;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="Distro"
                        Description="Which installed distribution to export.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox MinWidth="220"
                                      ItemsSource="{x:Bind Vm.Distros, Mode=OneWay}"
                                      SelectedItem="{x:Bind Vm.ExportDistro, Mode=TwoWay}" />
                            <Button Content="Refresh" Command="{x:Bind Vm.LoadDistrosCommand}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Format"
                        Description="tar = portable Linux filesystem (most compatible). tar.gz = compressed tar (smaller file, slower). vhd = WSL2 virtual disk (fast to re-import, larger file).">
                        <ComboBox ItemsSource="{x:Bind Vm.Formats}"
                                  SelectedItem="{x:Bind Vm.ExportFormat, Mode=TwoWay}" MinWidth="140" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Output path"
                        Description="Where to write the archive file.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{x:Bind Vm.ExportPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="240" />
                            <Button Content="Browse…" Click="BrowseExport_Click" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Export"
                        Description="Run the export, or copy the equivalent wsl.exe command.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Export" Click="Export_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="CopyExportPs_Click"
                                    ToolTipService.ToolTip="Copy the equivalent wsl.exe command to the clipboard">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE756;" FontSize="14" />
                                    <TextBlock Text="Copy PowerShell" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- ===== Restore ===== -->
            <controls:SettingsExpander
                Header="Restore"
                Description="Recreate a distribution from an archive made here or on another machine."
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE777;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="New name"
                        Description="Name for the recreated distro. Must not match an existing distro.">
                        <TextBox Text="{x:Bind Vm.RestoreName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="280" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Install directory"
                        Description="Folder on Windows where the restored distro's virtual disk will be stored. Pick an empty folder you own, e.g. C:\WSL\&lt;name&gt;.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{x:Bind Vm.RestoreInstallDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="240" />
                            <Button Content="Browse…" Click="BrowseRestoreDir_Click" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Source format"
                        Description="Match the archive type. Pick vhd only for a .vhdx disk image; tar and tar.gz both restore as a filesystem.">
                        <ComboBox ItemsSource="{x:Bind Vm.Formats}"
                                  SelectedItem="{x:Bind Vm.RestoreFormat, Mode=TwoWay}" MinWidth="140" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Archive"
                        Description="The backup file to restore (.tar, .tar.gz, or .vhdx).">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{x:Bind Vm.RestoreArchivePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="240" />
                            <Button Content="Browse…" Click="BrowseRestore_Click" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Restore"
                        Description="Run the restore, or copy the equivalent wsl.exe command.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Restore" Command="{x:Bind Vm.RestoreCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="CopyRestorePs_Click"
                                    ToolTipService.ToolTip="Copy the equivalent wsl.exe command to the clipboard">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE756;" FontSize="14" />
                                    <TextBlock Text="Copy PowerShell" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- ===== Register existing VHDX (import in place) ===== -->
            <controls:SettingsExpander
                Header="Register existing VHDX"
                Description="Register a virtual disk that is already on this machine as a new distro. The VHDX is used where it is — it is not copied. It must contain an ext4 filesystem.">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xEDA2;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="Name"
                        Description="Name for the new distro. Must not match an existing distro — registering over an existing name would silently replace it.">
                        <TextBox Text="{x:Bind Vm.InPlaceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="280" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="VHDX file"
                        Description="The existing .vhdx virtual disk to register. It stays at this location.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{x:Bind Vm.InPlaceVhdxPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="240" />
                            <Button Content="Browse…" Click="BrowseInPlace_Click" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Register"
                        Description="Register the disk with WSL. No data is moved or copied.">
                        <Button Content="Register" Command="{x:Bind Vm.ImportInPlaceCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
