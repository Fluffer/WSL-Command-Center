<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Wsl.App.Views.DeployPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="4" MaxWidth="1064" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                <TextBlock Text="Deploy a distribution" Style="{StaticResource TitleTextBlockStyle}" />
                <muxc:ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Width="20" Height="20"
                                   VerticalAlignment="Center" />
            </StackPanel>

            <muxc:InfoBar IsOpen="{x:Bind Vm.ErrorMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Error" Message="{x:Bind Vm.ErrorMessage, Mode=OneWay}" Margin="0,0,0,4" />
            <muxc:InfoBar IsOpen="{x:Bind Vm.StatusMessage, Mode=OneWay, Converter={StaticResource NotNullToBool}}"
                          Severity="Success" Message="{x:Bind Vm.StatusMessage, Mode=OneWay}" Margin="0,0,0,4" />

            <!-- ===== From catalog ===== -->
            <controls:SettingsExpander
                Header="From catalog"
                Description="Download a fresh distribution from Microsoft's online catalog. Needs an internet connection."
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE753;" />
                </controls:SettingsExpander.HeaderIcon>
                <Button Content="Reload catalog" Command="{x:Bind Vm.LoadCatalogCommand}" />
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="Distro"
                        Description="Installed without launching (no first-run setup). Afterwards open it from the Dashboard or a terminal to create your Linux username and password.">
                        <ComboBox ItemsSource="{x:Bind Vm.Catalog, Mode=OneWay}"
                                  SelectedItem="{x:Bind Vm.SelectedCatalogEntry, Mode=TwoWay}"
                                  DisplayMemberPath="FriendlyName" MinWidth="280" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Install"
                        Description="Run the install, or copy the equivalent wsl.exe command.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Install" Command="{x:Bind Vm.InstallSelectedCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="CopyInstallPs_Click"
                                    ToolTipService.ToolTip="Copy the equivalent wsl.exe command to the clipboard">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE756;" FontSize="14" />
                                    <TextBlock Text="Copy PowerShell" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- ===== From archive ===== -->
            <controls:SettingsExpander
                Header="From archive"
                Description="Restore a backup, move a distro between machines, or import a custom Linux image. No internet needed."
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8B5;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="Name"
                        Description="A unique name for the new distro — how it appears in the distro list and `wsl -d &lt;name&gt;`.">
                        <TextBox Text="{x:Bind Vm.ImportName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="280" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Install directory"
                        Description="Folder on Windows where the distro's virtual disk (ext4.vhdx) will live. Use an empty folder you own, e.g. C:\WSL\&lt;name&gt;.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{x:Bind Vm.ImportInstallDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="240" />
                            <Button Content="Browse…" Click="BrowseDir_Click" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Archive"
                        Description=".tar / .tar.gz = a Linux filesystem (rootfs). .vhdx = a WSL2 virtual disk. The right import mode is chosen automatically from the file extension.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{x:Bind Vm.ImportArchivePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="240" />
                            <Button Content="Browse…" Click="BrowseArchive_Click" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Import"
                        Description="Create the distro from the archive, or copy the equivalent wsl.exe command.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Import" Command="{x:Bind Vm.ImportArchiveCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="CopyImportPs_Click"
                                    ToolTipService.ToolTip="Copy the equivalent wsl.exe command to the clipboard">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE756;" FontSize="14" />
                                    <TextBlock Text="Copy PowerShell" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!-- ===== Advanced install ===== -->
            <controls:SettingsExpander
                Header="Advanced install"
                Description="Install with a custom name, location or WSL version — from the online catalog or a local .wsl/.tar image. Great for running multiple instances of the same distro.">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE90F;" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        Header="Catalog distro"
                        Description="Pick from the online catalog. Disabled while a local image file is set below — clear one to use the other.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox ItemsSource="{x:Bind Vm.Catalog, Mode=OneWay}"
                                      SelectedItem="{x:Bind Vm.AdvancedCatalogEntry, Mode=TwoWay}"
                                      IsEnabled="{x:Bind Vm.IsAdvancedCatalogEnabled, Mode=OneWay}"
                                      DisplayMemberPath="FriendlyName" MinWidth="240" />
                            <Button Content="Clear" Click="ClearAdvancedCatalog_Click" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Local image file"
                        Description="A .wsl or .tar distribution image installed without downloading. Disabled while a catalog distro is selected above.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{x:Bind Vm.AdvancedFromFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{x:Bind Vm.IsAdvancedFileEnabled, Mode=OneWay}"
                                     MinWidth="240" />
                            <Button Content="Browse…" Click="BrowseAdvancedFile_Click"
                                    IsEnabled="{x:Bind Vm.IsAdvancedFileEnabled, Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Name"
                        Description="Registered distro name. Required for a local image; optional for a catalog distro (use it to install a second instance).">
                        <TextBox Text="{x:Bind Vm.AdvancedName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="280" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Location"
                        Description="Optional folder where the distro's virtual disk will live, e.g. on another drive. Leave empty for the WSL default.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{x:Bind Vm.AdvancedLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="240" />
                            <Button Content="Browse…" Click="BrowseAdvancedLocation_Click" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="WSL version"
                        Description="Version 2 is the default and recommended. Version 1 only for special cases (e.g. some network filesystems).">
                        <ComboBox SelectedIndex="{x:Bind Vm.AdvancedVersionIndex, Mode=TwoWay}" MinWidth="120">
                            <ComboBoxItem Content="WSL 1" />
                            <ComboBoxItem Content="WSL 2" />
                        </ComboBox>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Download from the web"
                        Description="Bypass the Microsoft Store and download the distro directly (--web-download). Only applies to catalog installs.">
                        <ToggleSwitch IsOn="{x:Bind Vm.AdvancedWebDownload, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        Header="Install"
                        Description="Installed without launching — open it afterwards from the Dashboard to finish first-run setup.">
                        <Button Content="Install" Command="{x:Bind Vm.InstallAdvancedCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
